{
	"compilerOptions": {
		"target": "ESNext",
		"module": "esnext",
		"rootDir": "./src",
		"outDir": "./dist",
		"moduleResolution": "node",
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*"]
}
